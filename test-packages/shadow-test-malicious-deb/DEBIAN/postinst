#!/bin/sh
# shadow-test-malicious postinst
#
# Safe test payload that triggers every Shadow detection path for apt packages.
# ALL actions are sandboxed — nothing reaches the real filesystem or network.
#
# Detection paths exercised:
#   [1] Read /etc/passwd          → LSM BLOCKED at Ring 0
#   [2] Read ~/.aws/credentials   → LSM BLOCKED at Ring 0
#   [3] Read ~/.ssh/id_rsa        → LSM BLOCKED at Ring 0
#   [4] TCP connect to C2 IP      → CONNECTION BLOCKED at Ring 0
#   [5] Spawn curl                → [ALERT] suspicious process
#   [6] Read .env                 → LSM BLOCKED at Ring 0

set -e

echo "[shadow-test-deb] postinst running — simulating malicious payload..."

# [1] Attempt to read /etc/passwd
echo "[shadow-test-deb] [1] Attempting to read /etc/passwd..."
cat /etc/passwd > /dev/null 2>&1 || echo "[shadow-test-deb] /etc/passwd blocked"

# [2] Attempt to read ~/.aws/credentials
echo "[shadow-test-deb] [2] Attempting to read ~/.aws/credentials..."
cat "${HOME}/.aws/credentials" > /dev/null 2>&1 || echo "[shadow-test-deb] AWS credentials blocked"

# [3] Attempt to read ~/.ssh/id_rsa
echo "[shadow-test-deb] [3] Attempting to read ~/.ssh/id_rsa..."
cat "${HOME}/.ssh/id_rsa" > /dev/null 2>&1 || echo "[shadow-test-deb] SSH key blocked"

# [4] Attempt TCP connection to known C2 IP (185.220.101.47:4444)
# nc exits immediately on failure — won't stall the sandbox
echo "[shadow-test-deb] [4] Attempting TCP connect to C2 IP 185.220.101.47:4444..."
nc -w 2 185.220.101.47 4444 > /dev/null 2>&1 || echo "[shadow-test-deb] C2 connect blocked"

# [5] Spawn curl (suspicious downloader)
echo "[shadow-test-deb] [5] Spawning curl..."
curl --version > /dev/null 2>&1 || echo "[shadow-test-deb] curl spawn flagged"

# [6] Attempt to read .env
echo "[shadow-test-deb] [6] Attempting to read .env..."
cat "${HOME}/.env" > /dev/null 2>&1 || echo "[shadow-test-deb] .env blocked"

echo "[shadow-test-deb] Payload simulation complete."
